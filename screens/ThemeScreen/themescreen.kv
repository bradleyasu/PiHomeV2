#:kivy 2.0.0
#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp

# ─────────────────────────────────────────────────────────────────────────────
# Theme preview card — a self-contained mini UI mockup in the theme's colors.
# Uses m_* color props (not the standard token names) so the base-class theme
# cascade can't overwrite each card's palette.
# ─────────────────────────────────────────────────────────────────────────────
<ThemeCard>:
    orientation: "vertical"
    size_hint_y: None
    height: dp(150)
    padding: dp(8)
    spacing: dp(8)

    canvas.before:
        # Page background (theme primary)
        Color:
            rgba: root.m_bg
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]
    canvas.after:
        # Active = accent ring, focused = subtle ring, else none
        Color:
            rgba: (root.m_accent[0], root.m_accent[1], root.m_accent[2], 1) if root.is_active else (root.m_text[0], root.m_text[1], root.m_text[2], 0.18) if root.focused else (0, 0, 0, 0)
        Line:
            rounded_rectangle: [self.x + dp(1), self.y + dp(1), self.width - dp(2), self.height - dp(2), dp(12)]
            width: 2.0 if root.is_active else 1.3

    # ── Header bar ───────────────────────────────────────────────
    BoxLayout:
        size_hint_y: None
        height: dp(22)
        padding: dp(6), 0
        spacing: dp(4)
        canvas.before:
            Color:
                rgba: root.m_header
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(6)]
        Widget:
        # accent + alert dots
        Widget:
            size_hint: None, None
            size: dp(8), dp(8)
            pos_hint: {"center_y": 0.5}
            canvas:
                Color:
                    rgba: root.m_alert
                Ellipse:
                    pos: self.pos
                    size: self.size
        Widget:
            size_hint: None, None
            size: dp(8), dp(8)
            pos_hint: {"center_y": 0.5}
            canvas:
                Color:
                    rgba: root.m_accent
                Ellipse:
                    pos: self.pos
                    size: self.size

    # ── Surface card with text samples + accent pill ─────────────
    BoxLayout:
        orientation: "vertical"
        padding: dp(8)
        spacing: dp(5)
        canvas.before:
            Color:
                rgba: root.m_surface
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(8)]

        Label:
            text: root.display_name
            font_name: "Nunito"
            font_size: sp(12)
            bold: True
            color: root.m_text
            halign: "left"
            valign: "middle"
            text_size: self.size
            shorten: True
            shorten_from: "right"

        Label:
            text: "The quick brown fox"
            font_name: "Nunito"
            font_size: sp(9)
            color: root.m_muted
            halign: "left"
            valign: "middle"
            text_size: self.size

        # Accent pill (button sample)
        Widget:
            size_hint_y: None
            height: dp(18)
            canvas:
                Color:
                    rgba: root.m_accent
                RoundedRectangle:
                    pos: self.pos
                    size: dp(54), self.height
                    radius: [dp(9)]


# ─────────────────────────────────────────────────────────────────────────────
# Theme picker screen
# ─────────────────────────────────────────────────────────────────────────────
<ThemeScreenScreen>:
    canvas.before:
        Color:
            rgba: root.bg_color
        Rectangle:
            size: self.size
            pos: self.pos

    BoxLayout:
        orientation: "vertical"
        size_hint: 1, 1

        # ── Header ───────────────────────────────────────────────
        BoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: dp(44)
            padding: dp(54), 0, dp(10), 0
            spacing: dp(8)
            canvas.before:
                Color:
                    rgba: root.header_color
                Rectangle:
                    size: self.size
                    pos: self.pos
                Color:
                    rgba: root.border_color
                Rectangle:
                    size: self.width, dp(1)
                    pos: self.x, self.y

            Label:
                text: ""
                font_name: "MaterialIcons"
                font_size: sp(20)
                color: root.accent_color
                size_hint_x: None
                width: dp(26)
                halign: "center"
                valign: "middle"
                text_size: self.size

            Label:
                text: "THEMES"
                font_name: "Nunito"
                font_size: sp(12)
                bold: True
                color: root.text_color
                size_hint_x: None
                width: dp(120)
                halign: "left"
                valign: "middle"
                text_size: self.size

            Widget:

            Label:
                text: "Tap a theme to apply"
                font_name: "Nunito"
                font_size: sp(10)
                color: root.muted_color
                size_hint_x: None
                width: dp(150)
                halign: "right"
                valign: "middle"
                text_size: self.size

        # ── Theme grid ───────────────────────────────────────────
        ScrollView:
            id: theme_scroll
            do_scroll_x: False
            bar_width: dp(3)
            bar_color: root.accent_color
            scroll_type: ["bars", "content"]

            GridLayout:
                id: theme_grid
                cols: 2
                size_hint_y: None
                height: self.minimum_height
                padding: dp(14)
                spacing: dp(14)
                row_default_height: dp(150)
                row_force_default: True
