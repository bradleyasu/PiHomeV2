#:kivy 2.0.0
#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp

<AutomationsScreen>:
    canvas.before:
        Color:
            rgba: root.bg_color
        Rectangle:
            size: self.size
            pos: self.pos

    BoxLayout:
        orientation: "vertical"
        size_hint: 1, 1

        # ── Header ────────────────────────────────────────────────────────────
        BoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: dp(44)
            padding: dp(54), 0, dp(10), 0
            spacing: dp(8)
            canvas.before:
                Color:
                    rgba: root.header_color
                Rectangle:
                    size: self.size
                    pos: self.pos
                Color:
                    rgba: 1, 1, 1, 0.06
                Rectangle:
                    size: self.width, dp(1)
                    pos: self.x, self.y
                Color:
                    rgba: 1, 1, 1, 1

            Label:
                text: ""
                font_name: "MaterialIcons"
                font_size: sp(20)
                color: root.accent_color
                size_hint_x: None
                width: dp(26)
                halign: "center"
                valign: "middle"
                text_size: self.size

            Label:
                text: "AUTOMATIONS"
                font_name: "Nunito"
                font_size: sp(12)
                bold: True
                color: root.text_color
                size_hint_x: None
                width: dp(110)
                halign: "left"
                valign: "middle"
                text_size: self.size

            Widget:

            Label:
                text: "TAP TO TEST"
                font_name: "Nunito"
                font_size: sp(9)
                color: root.muted_color
                size_hint_x: None
                width: dp(80)
                halign: "right"
                valign: "middle"
                text_size: self.size
                # Meaningless when there is nothing to tap.
                opacity: 0 if root.is_empty else 1

        # ── Body ──────────────────────────────────────────────────────────────
        FloatLayout:
            size_hint: 1, 1

            ScrollView:
                size_hint: 1, 1
                pos: self.parent.pos
                do_scroll_x: False
                bar_width: dp(3)
                bar_color: root.accent_color
                scroll_type: ["bars", "content"]

                BoxLayout:
                    id: rows_box
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    padding: dp(6), dp(8)
                    spacing: dp(4)

            # Empty state. Sized to its content and never `disabled` — a disabled
            # full-screen overlay would swallow every touch beneath it, killing
            # scrolling on the list (CLAUDE.md gotcha #10).
            BoxLayout:
                orientation: "vertical"
                size_hint: None, None
                size: dp(420), dp(196)
                pos_hint: {"center_x": 0.5, "center_y": 0.5}
                spacing: dp(6)
                opacity: 1 if root.is_empty else 0

                Label:
                    text: ""
                    font_name: "MaterialIcons"
                    font_size: sp(44)
                    color: root.muted_color
                    opacity: 0.35
                    size_hint_y: None
                    height: dp(52)
                    halign: "center"
                    valign: "middle"
                    text_size: self.size

                Label:
                    text: "No automations yet"
                    font_name: "Nunito"
                    font_size: sp(14)
                    color: root.muted_color
                    size_hint_y: None
                    height: dp(22)
                    halign: "center"
                    valign: "middle"
                    text_size: self.size

                Label:
                    text: root.empty_hint
                    font_name: "Nunito"
                    font_size: sp(11)
                    color: root.muted_color
                    opacity: 0.7
                    size_hint_y: None
                    height: dp(32)
                    halign: "center"
                    valign: "top"
                    text_size: self.size

                # The actual event types the user can send, built from whichever
                # rule stores are registered — so this is never stale jargon.
                Label:
                    text: root.empty_events
                    font_name: "Nunito"
                    font_size: sp(11)
                    bold: True
                    color: root.accent_color
                    size_hint_y: None
                    height: dp(56)
                    halign: "center"
                    valign: "top"
                    text_size: self.size
