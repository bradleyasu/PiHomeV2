#:kivy 2.0.0
#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp

<NotificationRow>:
    orientation: "horizontal"
    size_hint_y: None
    height: max(dp(64), label_box.minimum_height + dp(20))
    padding: dp(10), dp(8)
    spacing: dp(10)

    canvas.before:
        Color:
            rgba: root.row_bg_color
        RoundedRectangle:
            pos: self.x + dp(6), self.y + dp(3)
            size: self.width - dp(12), self.height - dp(6)
            radius: [dp(10)]
        # Reset GL color state for Pi's OpenGL ES 2.0 batcher.
        Color:
            rgba: 1, 1, 1, 1

    # ── Icon slot (NetworkImage when icon URL given, else MaterialIcons glyph) ──
    FloatLayout:
        size_hint_x: None
        width: dp(48)

        NetworkImage:
            url: root.icon_url
            opacity: 1 if root.has_icon else 0
            size_hint: None, None
            size: dp(40), dp(40)
            pos_hint: {"center_x": 0.5, "center_y": 0.5}

        Label:
            text: root.glyph
            font_name: "MaterialIcons"
            font_size: sp(26)
            color: root.glyph_color
            opacity: 0 if root.has_icon else 1
            halign: "center"
            valign: "middle"
            size_hint: None, None
            size: dp(40), dp(40)
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            text_size: self.size

    # ── Title + description ────────────────────────────────────────────────────
    BoxLayout:
        id: label_box
        orientation: "vertical"
        spacing: dp(2)
        padding: 0, dp(2)
        size_hint_y: None
        height: self.minimum_height
        pos_hint: {"center_y": 0.5}

        Label:
            text: root.title
            font_name: "Nunito"
            font_size: sp(14)
            bold: True
            color: root.text_color
            halign: "left"
            valign: "middle"
            size_hint_y: None
            height: self.texture_size[1]
            text_size: self.width, None

        Label:
            text: root.description
            font_name: "Nunito"
            font_size: sp(12)
            color: root.muted_color
            halign: "left"
            valign: "top"
            size_hint_y: None
            height: self.texture_size[1] if root.description else 0
            opacity: 1 if root.description else 0
            text_size: self.width, None

    # ── Clear (x) button — grabs its own touch so the row tap won't fire ───────
    Button:
        id: clear_btn
        size_hint: None, None
        size: dp(36), dp(36)
        pos_hint: {"center_y": 0.5}
        text: ""
        font_name: "MaterialIcons"
        font_size: sp(20)
        color: root.danger_color
        background_normal: ""
        background_down: ""
        background_color: 0, 0, 0, 0
        on_release: root._do_clear()
        canvas.before:
            Color:
                rgba: root.danger_color[0], root.danger_color[1], root.danger_color[2], 0.12
            Ellipse:
                pos: self.x + dp(2), self.y + dp(2)
                size: self.width - dp(4), self.height - dp(4)
            Color:
                rgba: 1, 1, 1, 1
