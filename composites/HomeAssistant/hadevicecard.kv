#:kivy 2.0.0
#:import dp kivy.metrics.dp
#:import AsyncImage kivy.uix.image.AsyncImage

# ─────────────────────────────────────────────────────────────────────────────
# HAIconButton — tappable icon/label button used for all in-card controls.
# Fires on release (ButtonBehavior), draws a pressed background, nudges 1px
# down while held for a tactile cue. Defined in hadevicecard.py.
# ─────────────────────────────────────────────────────────────────────────────
<HAIconButton>:
    halign: 'center'
    valign: 'middle'
    text_size: self.size
    canvas.before:
        Color:
            rgba: self.bg_pressed if self.state == 'down' else self.bg_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.radius]

# ─────────────────────────────────────────────────────────────────────────────
# Base rule — applies to all HADeviceCard subclasses via kv inheritance
# Draws a focus ring when root.focused == True
# ─────────────────────────────────────────────────────────────────────────────
<HADeviceCard>:
    on_touch_down: if self.collide_point(*args[1].pos): root._on_self_touched()
    canvas.after:
        Color:
            rgba: root.accent_color[0], root.accent_color[1], root.accent_color[2], (0.85 if root.focused else 0)
        Line:
            rounded_rectangle: (self.x + dp(2), self.y + dp(2), self.width - dp(4), self.height - dp(4), dp(12))
            width: dp(2)

# ─────────────────────────────────────────────────────────────────────────────
# Shared card canvas macro — rounded dark/light card surface
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────────
# HALightCard  —  on/off switch + optional brightness slider
# ─────────────────────────────────────────────────────────────────────────────
<HALightCard>:
    orientation: 'vertical'
    size_hint: 1, 1
    spacing: 0

    canvas.before:
        Color:
            rgba: root.card_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(14)]

    # ── Name row ──────────────────────────────────────────────────────────────
    BoxLayout:
        orientation: 'horizontal'
        size_hint: 1, 1
        padding: [dp(14), dp(12), dp(14), dp(4)]
        spacing: dp(10)

        # Domain icon (lit up when on, dim when off)
        Label:
            text: root.domain_icon
            font_name: 'MaterialIcons'
            font_size: '20sp'
            color: root.accent_color if root.is_on else (root.text_color[0], root.text_color[1], root.text_color[2], 0.30)
            size_hint: None, 1
            width: dp(26)

        # Friendly name
        Label:
            text: root.entity_name
            font_name: 'Nunito'
            font_size: '13sp'
            bold: True
            color: root.text_color
            halign: 'left'
            valign: 'middle'
            text_size: self.width, None
            size_hint: 1, 1

        # Favorite star
        HAIconButton:
            text: root.star_filled if root.is_favorite else root.star_outline
            font_name: 'MaterialIcons'
            font_size: '18sp'
            color: (1.0, 0.78, 0.08, 1) if root.is_favorite else (root.text_color[0], root.text_color[1], root.text_color[2], 0.25)
            bg_color: 0, 0, 0, 0
            bg_pressed: root.text_color[0], root.text_color[1], root.text_color[2], 0.12
            size_hint: None, 1
            width: dp(30)
            on_release: root.toggle_favorite()

        # On / off switch
        PiHomeSwitch:
            id: main_switch
            size_hint: None, None
            size: dp(46), dp(26)
            pos_hint: {'center_y': 0.5}
            on_enabled: root._on_switch_touch(self.enabled)
    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(36)
        padding: [dp(14), dp(0), dp(14), dp(10)]
        spacing: dp(8)
        opacity: 1 if root.supports_brightness else 0

        # Brightness icon
        Label:
            text: '\ue518'
            font_name: 'MaterialIcons'
            font_size: '15sp'
            color: root.text_color[0], root.text_color[1], root.text_color[2], 0.40
            size_hint: None, 1
            width: dp(18)

        # Brightness slider
        HASlider:
            id: brightness_slider
            fill_color: root.accent_color
            on_value: root._on_slider_change(self.value)

        # Percentage label
        Label:
            text: str(int(root.brightness_pct)) + '%'
            font_name: 'Nunito'
            font_size: '11sp'
            color: root.text_color[0], root.text_color[1], root.text_color[2], 0.45
            size_hint: None, 1
            width: dp(32)
            halign: 'right'
            valign: 'middle'
            text_size: self.size


# ─────────────────────────────────────────────────────────────────────────────
# HAToggleCard  —  single on/off switch  (switch, input_boolean, fan)
# ─────────────────────────────────────────────────────────────────────────────
<HAToggleCard>:
    orientation: 'vertical'
    size_hint: 1, 1

    canvas.before:
        Color:
            rgba: root.card_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(14)]

    BoxLayout:
        orientation: 'horizontal'
        size_hint: 1, 1
        padding: [dp(14), dp(14), dp(14), dp(14)]
        spacing: dp(10)

        Label:
            text: root.domain_icon
            font_name: 'MaterialIcons'
            font_size: '20sp'
            color: root.accent_color if root.is_on else (root.text_color[0], root.text_color[1], root.text_color[2], 0.30)
            size_hint: None, 1
            width: dp(26)

        Label:
            text: root.entity_name
            font_name: 'Nunito'
            font_size: '13sp'
            bold: True
            color: root.text_color
            halign: 'left'
            valign: 'middle'
            text_size: self.width, None
            size_hint: 1, 1

        # Favorite star
        HAIconButton:
            text: root.star_filled if root.is_favorite else root.star_outline
            font_name: 'MaterialIcons'
            font_size: '18sp'
            color: (1.0, 0.78, 0.08, 1) if root.is_favorite else (root.text_color[0], root.text_color[1], root.text_color[2], 0.25)
            bg_color: 0, 0, 0, 0
            bg_pressed: root.text_color[0], root.text_color[1], root.text_color[2], 0.12
            size_hint: None, 1
            width: dp(30)
            on_release: root.toggle_favorite()

        PiHomeSwitch:
            id: main_switch
            size_hint: None, None
            size: dp(46), dp(26)
            pos_hint: {'center_y': 0.5}
            on_enabled: root._on_switch_touch(self.enabled)


# ─────────────────────────────────────────────────────────────────────────────
# HACoverCard  —  open / close buttons  (cover, blind, garage door)
# ─────────────────────────────────────────────────────────────────────────────
<HACoverCard>:
    orientation: 'vertical'
    size_hint: 1, 1

    canvas.before:
        Color:
            rgba: root.card_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(14)]

    BoxLayout:
        orientation: 'horizontal'
        size_hint: 1, 1
        padding: [dp(14), dp(14), dp(14), dp(14)]
        spacing: dp(10)

        Label:
            text: root.domain_icon
            font_name: 'MaterialIcons'
            font_size: '20sp'
            color: root.accent_color
            size_hint: None, 1
            width: dp(26)

        BoxLayout:
            orientation: 'vertical'
            size_hint: 1, 1
            spacing: dp(2)

            Label:
                text: root.entity_name
                font_name: 'Nunito'
                font_size: '13sp'
                bold: True
                color: root.text_color
                halign: 'left'
                valign: 'bottom'
                text_size: self.width, None
                size_hint: 1, 1

            Label:
                text: root.state.upper()
                font_name: 'Nunito'
                font_size: '10sp'
                color: root.text_color[0], root.text_color[1], root.text_color[2], 0.38
                halign: 'left'
                valign: 'top'
                text_size: self.width, None
                size_hint: 1, None
                height: dp(14)

        # Favorite star
        HAIconButton:
            text: root.star_filled if root.is_favorite else root.star_outline
            font_name: 'MaterialIcons'
            font_size: '18sp'
            color: (1.0, 0.78, 0.08, 1) if root.is_favorite else (root.text_color[0], root.text_color[1], root.text_color[2], 0.25)
            bg_color: 0, 0, 0, 0
            bg_pressed: root.text_color[0], root.text_color[1], root.text_color[2], 0.12
            size_hint: None, 1
            width: dp(30)
            on_release: root.toggle_favorite()

        # Open (up) button
        HAIconButton:
            size_hint: None, None
            size: dp(38), dp(38)
            pos_hint: {'center_y': 0.5}
            text: '\ue5d8'
            font_name: 'MaterialIcons'
            font_size: '22sp'
            color: root.accent_color
            bg_color: root.accent_color[0], root.accent_color[1], root.accent_color[2], 0.18
            bg_pressed: root.accent_color[0], root.accent_color[1], root.accent_color[2], 0.42
            on_release: root._cover_open()

        Widget:
            size_hint: None, 1
            width: dp(6)

        # Close (down) button
        HAIconButton:
            size_hint: None, None
            size: dp(38), dp(38)
            pos_hint: {'center_y': 0.5}
            text: '\ue5db'
            font_name: 'MaterialIcons'
            font_size: '22sp'
            color: root.text_color[0], root.text_color[1], root.text_color[2], 0.70
            bg_color: root.text_color[0], root.text_color[1], root.text_color[2], 0.08
            bg_pressed: root.text_color[0], root.text_color[1], root.text_color[2], 0.22
            on_release: root._cover_close()


# ─────────────────────────────────────────────────────────────────────────────
