            text: 'Run'
            font_name: 'Nunito'
            font_size: '12sp'
            bold: True
            color: root.accent_color
            bg_color: root.accent_color[0], root.accent_color[1], root.accent_color[2], 0.18
            bg_pressed: root.accent_color[0], root.accent_color[1], root.accent_color[2], 0.42
            on_release: root._trigger_run()


# ─────────────────────────────────────────────────────────────────────────────
# HAClimateCard  —  current temp display + target temperature slider
# ─────────────────────────────────────────────────────────────────────────────
<HAClimateCard>:
    orientation: 'vertical'
    size_hint: 1, 1

    canvas.before:
        Color:
            rgba: root.card_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(14)]

    # ── Name row ────────────────────────────────────────────────────────────────────────
    BoxLayout:
        orientation: 'horizontal'
        size_hint: 1, None
        height: dp(44)
        padding: [dp(14), dp(10), dp(14), dp(0)]
        spacing: dp(10)

        Label:
            text: root.domain_icon
            font_name: 'MaterialIcons'
            font_size: '20sp'
            color: root.hvac_action_color if root.is_on else (root.text_color[0], root.text_color[1], root.text_color[2], 0.30)
            size_hint: None, 1
            width: dp(26)

        Label:
            text: root.entity_name
            font_name: 'Nunito'
            font_size: '13sp'
            bold: True
            color: root.text_color
            halign: 'left'
            valign: 'middle'
            text_size: self.width, None
            size_hint: 1, 1

        # Favorite star
        HAIconButton:
            text: root.star_filled if root.is_favorite else root.star_outline
            font_name: 'MaterialIcons'
            font_size: '18sp'
            color: (1.0, 0.78, 0.08, 1) if root.is_favorite else (root.text_color[0], root.text_color[1], root.text_color[2], 0.25)
            bg_color: 0, 0, 0, 0
            bg_pressed: root.text_color[0], root.text_color[1], root.text_color[2], 0.12
            size_hint: None, 1
            width: dp(30)
            on_release: root.toggle_favorite()

    # ── Temperature info row ────────────────────────────────────────────────────────
    BoxLayout:
        orientation: 'horizontal'
        size_hint: 1, None
        height: dp(36)
        padding: [dp(14), dp(0), dp(14), dp(0)]
        spacing: dp(8)

        # Current temperature (large)
        Label:
            text: ('{:.1f}'.format(root.current_temp) + root.temp_unit) if root.current_temp else '--'
            font_name: 'Nunito'
            font_size: '20sp'
            bold: True
            color: root.text_color
            size_hint: None, 1
            width: dp(72)
            halign: 'left'
            valign: 'middle'
            text_size: self.size

        # HVAC action badge (HEATING / COOLING / IDLE …)
        Label:
            text: root.hvac_action.upper()
            font_name: 'Nunito'
            font_size: '9sp'
            bold: True
            color: root.hvac_action_color
            size_hint: 1, 1
            halign: 'left'
            valign: 'middle'
            text_size: self.width, None

        # Target temperature — plain Nunito text, no Unicode arrow
        Label:
            text: 'Set: ' + '{:.1f}'.format(root.target_temp) + root.temp_unit
            font_name: 'Nunito'
            font_size: '12sp'
            color: root.text_color[0], root.text_color[1], root.text_color[2], 0.60
            size_hint: None, 1
            width: dp(86)
            halign: 'right'
            valign: 'middle'
            text_size: self.size

    # ── Target temperature slider ──────────────────────────────────────────────────
    BoxLayout:
        orientation: 'horizontal'
        size_hint: 1, None
        height: dp(36)
        padding: [dp(14), dp(0), dp(14), dp(10)]
        spacing: dp(8)

        Label:
            text: '{:.0f}'.format(root.min_temp) + root.temp_unit
            font_name: 'Nunito'
            font_size: '10sp'
            color: root.text_color[0], root.text_color[1], root.text_color[2], 0.35
            size_hint: None, 1
            width: dp(30)
            halign: 'left'
            valign: 'middle'
            text_size: self.size

        HASlider:
            id: temp_slider
            fill_color: root.hvac_action_color
            on_value: root._on_temp_slider_change(self.value)

        Label:
            text: '{:.0f}'.format(root.max_temp) + root.temp_unit
            font_name: 'Nunito'
            font_size: '10sp'
            color: root.text_color[0], root.text_color[1], root.text_color[2], 0.35
            size_hint: None, 1
            width: dp(30)
            halign: 'right'
            valign: 'middle'
            text_size: self.size


# ─────────────────────────────────────────────────────────────────────────────
# HAMediaCard  —  album art thumbnail + now-playing info + transport controls
# ─────────────────────────────────────────────────────────────────────────────
<HAMediaCard>:
    orientation: 'horizontal'
    size_hint: 1, 1

    canvas.before:
        Color:
            rgba: root.card_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(14)]

    # ── Album art panel (left) ────────────────────────────────────────────────────────
    BoxLayout:
        size_hint: None, 1
        width: dp(102)
        padding: [dp(8), dp(6), dp(4), dp(6)]

        FloatLayout:
            size_hint: 1, 1

            # Placeholder icon shown when no image is available
            Label:
                text: root.domain_icon
                font_name: 'MaterialIcons'
                font_size: '30sp'
                color: root.accent_color[0], root.accent_color[1], root.accent_color[2], 0.28
                opacity: 0 if root.media_img_url else 1
                size_hint: 1, 1
                pos_hint: {'x': 0, 'y': 0}
                halign: 'center'
                valign: 'middle'
                text_size: self.size

            # Album art (async, fades in when available)
            AsyncImage:
                id: album_art
                source: root.media_img_url
                allow_stretch: True
                keep_ratio: True
                opacity: 1 if root.media_img_url else 0
                size_hint: 1, 1
                pos_hint: {'x': 0, 'y': 0}

    # ── Info + controls panel (right) ────────────────────────────────────────────────
    BoxLayout:
        orientation: 'vertical'
        size_hint: 1, 1
        padding: [dp(4), dp(8), dp(12), dp(8)]
        spacing: dp(2)

        # Entity name + star
        BoxLayout:
            orientation: 'horizontal'
            size_hint: 1, None
            height: dp(20)

            Label:
                text: root.entity_name
                font_name: 'Nunito'
                font_size: '12sp'
                bold: True
                color: root.text_color
                halign: 'left'
                valign: 'middle'
                shorten: True
                shorten_from: 'right'
                text_size: self.width, self.height
                size_hint: 1, 1

            # Favorite star
            HAIconButton:
                text: root.star_filled if root.is_favorite else root.star_outline
                font_name: 'MaterialIcons'
                font_size: '17sp'
                color: (1.0, 0.78, 0.08, 1) if root.is_favorite else (root.text_color[0], root.text_color[1], root.text_color[2], 0.25)
                bg_color: 0, 0, 0, 0
                bg_pressed: root.text_color[0], root.text_color[1], root.text_color[2], 0.12
                size_hint: None, 1
                width: dp(26)
                on_release: root.toggle_favorite()

        # Media title
        Label:
            text: root.media_title if root.media_title else root.media_state.capitalize()
            font_name: 'Nunito'
            font_size: '11sp'
            color: root.text_color
            halign: 'left'
            valign: 'middle'
            shorten: True
            shorten_from: 'right'
            text_size: self.width, self.height
            size_hint: 1, None
            height: dp(16)

        # Artist / album
        Label:
            text: root.media_artist
            font_name: 'Nunito'
            font_size: '10sp'
            color: root.text_color[0], root.text_color[1], root.text_color[2], 0.55
            halign: 'left'
            valign: 'middle'
            shorten: True
            shorten_from: 'right'
            text_size: self.width, self.height
            size_hint: 1, None
            height: dp(14)

        # Transport controls row
        BoxLayout:
            orientation: 'horizontal'
            size_hint: 1, None
            height: dp(28)
            spacing: dp(6)

            # Prev
            HAIconButton:
                size_hint: None, None
                size: dp(30), dp(28)
                radius: dp(8)
                text: '\ue045'
                font_name: 'MaterialIcons'
                font_size: '18sp'
                color: root.text_color[0], root.text_color[1], root.text_color[2], 0.70
                bg_color: root.text_color[0], root.text_color[1], root.text_color[2], 0.07
                bg_pressed: root.text_color[0], root.text_color[1], root.text_color[2], 0.20
                on_release: root._prev_track()

            # Play / Pause
            HAIconButton:
                size_hint: None, None
                size: dp(30), dp(28)
                radius: dp(8)
                text: '\ue034' if root.is_playing else '\ue037'
                font_name: 'MaterialIcons'
                font_size: '19sp'
                color: root.accent_color
                bg_color: root.accent_color[0], root.accent_color[1], root.accent_color[2], 0.22
                bg_pressed: root.accent_color[0], root.accent_color[1], root.accent_color[2], 0.45
                on_release: root._play_pause()

            # Next
            HAIconButton:
                size_hint: None, None
                size: dp(30), dp(28)
                radius: dp(8)
                text: '\ue044'
                font_name: 'MaterialIcons'
                font_size: '18sp'
                color: root.text_color[0], root.text_color[1], root.text_color[2], 0.70
                bg_color: root.text_color[0], root.text_color[1], root.text_color[2], 0.07
                bg_pressed: root.text_color[0], root.text_color[1], root.text_color[2], 0.20
                on_release: root._next_track()

            Widget:
                size_hint: 1, 1

        # Volume row
        BoxLayout:
            orientation: 'horizontal'
            size_hint: 1, None
            height: dp(28)
            spacing: dp(6)

            Label:
                text: '\ue050'
                font_name: 'MaterialIcons'
                font_size: '15sp'
                color: root.text_color[0], root.text_color[1], root.text_color[2], 0.40
                size_hint: None, 1
                width: dp(18)

            HASlider:
                id: volume_slider
                fill_color: root.accent_color
                on_value: root._on_volume_change(self.value)

            Label:
                text: str(int(root.volume_pct)) + '%'
                font_name: 'Nunito'
                font_size: '10sp'
                color: root.text_color[0], root.text_color[1], root.text_color[2], 0.45
                size_hint: None, 1
                width: dp(32)
                halign: 'right'
                valign: 'middle'
                text_size: self.size
